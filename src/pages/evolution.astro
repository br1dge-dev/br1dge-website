<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="An evolving field of light and gravity." />
    <title>br1dge ∩</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90' fill='white'>∩</text></svg>" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://br1dge.xyz/" />
    <meta property="og:title" content="br1dge ∩" />
    <meta property="og:description" content="A visual interactive experience." />
    <meta property="og:site_name" content="br1dge" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://br1dge.xyz/og-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="br1dge ∩ logo on black background" />

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@br1dge_eth" />
    <meta name="twitter:creator" content="@br1dge_eth" />
    <meta name="twitter:title" content="br1dge ∩" />
    <meta name="twitter:description" content="A visual interactive experience." />
    <meta name="twitter:image" content="https://br1dge.xyz/twitter-image.png" />
    <meta name="twitter:image:alt" content="br1dge ∩ logo on black background" />

    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: #000; cursor: none; }
      #canvas { position: fixed; inset: 0; width: 100%; height: 100%; touch-action: none; }
      [hidden] { display: none !important; }
      .control { position: fixed; bottom: max(18px, env(safe-area-inset-bottom)); z-index: 30; border: 0; background: none; color: #fff; opacity: .4; padding: 12px; cursor: pointer; transition: opacity .25s; }
      .control:hover, .control:focus-visible { opacity: .9; }
      .control svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
      #sound-toggle { right: max(15px, env(safe-area-inset-right)); }
      #pause-toggle { left: max(15px, env(safe-area-inset-left)); }
      #pause-toggle .play { display: none; }
      #pause-toggle[aria-pressed="true"] .pause { display: none; }
      #pause-toggle[aria-pressed="true"] .play { display: block; }
      button:focus-visible { outline: 1px solid #a1bdb0; outline-offset: 3px; border-radius: 50%; }
      #evolution-reentry { position: fixed; z-index: 20; top: 50%; left: 50%; transform: translate(-50%, -50%); width: clamp(110px, 24vmin, 190px); height: clamp(110px, 26vmin, 210px); border: 0; background: none; border-radius: 50%; cursor: pointer; }
      #evolution-death { position:fixed; inset:0; z-index:20; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:28px; background:rgba(0,0,0,.65); animation:death-in 1.1s ease-out both; }
      #evolution-death h1 { margin:0; color:#9e2025; font:400 clamp(38px,9vw,92px)/1.2 Georgia,serif; letter-spacing:.12em; text-align:center; text-shadow:0 0 26px rgba(145,15,25,.15); }
      #evolution-retry { border-radius:2px; color:#b9aaa5; border:1px solid rgba(160,120,115,.28); background:transparent; padding:13px 23px; font:300 14px/1.3 "Helvetica Neue",sans-serif; letter-spacing:.06em; cursor:pointer; }
      #evolution-retry:hover,#evolution-retry:focus-visible { color:#eee2dd; border-color:#9e2025; }
      @keyframes death-in { from{opacity:0} to{opacity:1} }
      @media(prefers-reduced-motion:reduce){#evolution-death{animation:none}}
      astro-dev-toolbar { display: none; }
    </style>
  </head>
  <body>
    <canvas id="canvas" data-evolution="true" aria-label="Interactive field of light and gravity"></canvas>
    <section id="evolution-death" role="dialog" aria-modal="true" aria-labelledby="death-title" hidden>
      <h1 id="death-title">YOU DIED</h1>
      <button id="evolution-retry">Get gud – try again</button>
    </section>
    <button id="evolution-reentry" aria-label="Continue" hidden></button>
    <button id="pause-toggle" class="control" aria-label="Pause game" aria-pressed="false">
      <svg viewBox="0 0 24 24" class="pause" aria-hidden="true"><path d="M8 6v12M16 6v12" /></svg>
      <svg viewBox="0 0 24 24" class="play" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg>
    </button>
    <button id="sound-toggle" class="control" aria-label="Enable sound">
      <svg viewBox="0 0 24 24" class="sound-on" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z" /><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" /></svg>
      <svg viewBox="0 0 24 24" class="sound-off" style="display:none" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z" /><path d="m17 9 6 6m0-6-6 6" /></svg>
    </button>
    <script>import '../lib/game/accepted-preview.js';</script>
  </body>
</html>
